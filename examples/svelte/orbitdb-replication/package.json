    "test:unit": "vitest --run --config vitest.config.js",
    "test:browser": "vitest --browser --run --config vitest.browser.config.js",
    "test": "npm run test:unit && npm run test:browser && npm run test:e2e",
    "test:e2e": "playwright test"
  },
